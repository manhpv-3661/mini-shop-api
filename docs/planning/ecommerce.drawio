<mxfile host="app.diagrams.net" modified="2026-09-09T00:00:00.000Z" agent="Claude" version="24.7.17" type="device" compressed="false">
  <diagram id="mini-shop-erd" name="Mini Shop ERD">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="2050" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="&lt;b&gt;Mini Shop — PostgreSQL ERD (Full scope 130 giờ / 25 ngày)&lt;/b&gt;&lt;br&gt;PK = primary key · FK = foreign key · UK = unique · ? = nullable&lt;br&gt;Lane theo domain: &lt;b&gt;&lt;font color=#3f6fb4&gt;Identity&lt;/font&gt;&lt;/b&gt; · &lt;b&gt;&lt;font color=#5f9e4f&gt;Catalog&lt;/font&gt;&lt;/b&gt; · &lt;b&gt;&lt;font color=#c98a1a&gt;Cart &amp;amp; Checkout&lt;/font&gt;&lt;/b&gt; · &lt;b&gt;&lt;font color=#b89b3a&gt;Audit/Feedback/Notify&lt;/font&gt;&lt;/b&gt; · &lt;b&gt;&lt;font color=#9673a6&gt;Advance scope&lt;/font&gt;&lt;/b&gt; (dải tím phía dưới)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1520" height="70" as="geometry"/>
        </mxCell>

        <!-- Lane headers -->
        <mxCell id="lane_identity" value="IDENTITY &amp; ACCESS" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#ffffff;fillColor=#3f6fb4;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="350" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="lane_catalog" value="CATALOG" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#ffffff;fillColor=#5f9e4f;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="430" y="100" width="350" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="lane_commerce" value="CART &amp; CHECKOUT" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#ffffff;fillColor=#c98a1a;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="820" y="100" width="350" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="lane_feedback" value="AUDIT · FEEDBACK · NOTIFY" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#ffffff;fillColor=#b89b3a;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="1210" y="100" width="350" height="36" as="geometry"/>
        </mxCell>

        <!-- Lane 1: Identity & Access -->
        <mxCell id="users" value="&lt;b&gt;users&lt;/b&gt;&lt;br&gt;PK id uuid&lt;br&gt;UK email varchar(254)&lt;br&gt;UK username varchar(30)&lt;br&gt;password_hash varchar(255)&lt;br&gt;role CUSTOMER|ADMIN&lt;br&gt;status PENDING|ACTIVE|INACTIVE&lt;br&gt;email_verified_at? timestamptz&lt;br&gt;token_version int&lt;br&gt;created_at / updated_at" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#dae8fc;strokeColor=#3f6fb4;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="150" width="350" height="300" as="geometry"/>
        </mxCell>
        <mxCell id="auth_tokens" value="&lt;b&gt;auth_tokens&lt;/b&gt;&lt;br&gt;PK id uuid&lt;br&gt;FK user_id → users · RESTRICT&lt;br&gt;type EMAIL_VERIFICATION|PASSWORD_RESET&lt;br&gt;UK token_hash char(64)&lt;br&gt;expires_at timestamptz&lt;br&gt;used_at? timestamptz&lt;br&gt;created_at timestamptz" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#dae8fc;strokeColor=#3f6fb4;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="480" width="350" height="250" as="geometry"/>
        </mxCell>

        <!-- Lane 2: Catalog -->
        <mxCell id="categories" value="&lt;b&gt;categories&lt;/b&gt;&lt;br&gt;PK id uuid&lt;br&gt;name varchar(100)&lt;br&gt;UK slug varchar(120)&lt;br&gt;is_active boolean&lt;br&gt;created_at timestamptz&lt;br&gt;updated_at timestamptz" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#d5e8d4;strokeColor=#5f9e4f;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="430" y="150" width="350" height="210" as="geometry"/>
        </mxCell>
        <mxCell id="attachments" value="&lt;b&gt;attachments&lt;/b&gt;&lt;br&gt;PK id uuid&lt;br&gt;UK storage_key varchar(255)&lt;br&gt;mime_type image/jpeg|image/png|image/webp&lt;br&gt;size_bytes int (1..2097152)&lt;br&gt;created_at timestamptz" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#d5e8d4;strokeColor=#5f9e4f;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="430" y="390" width="350" height="190" as="geometry"/>
        </mxCell>
        <mxCell id="products" value="&lt;b&gt;products&lt;/b&gt;&lt;br&gt;PK id uuid&lt;br&gt;FK category_id → categories · RESTRICT&lt;br&gt;FK,UK image_id? → attachments · SET NULL&lt;br&gt;name varchar(200)&lt;br&gt;description text&lt;br&gt;UK sku varchar(64)&lt;br&gt;price_vnd numeric(14,0)&lt;br&gt;stock int CHECK ≥ 0&lt;br&gt;is_active / is_featured boolean&lt;br&gt;created_at / updated_at timestamptz" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#d5e8d4;strokeColor=#5f9e4f;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="430" y="610" width="350" height="330" as="geometry"/>
        </mxCell>

        <!-- Lane 3: Cart & Checkout -->
        <mxCell id="cart_items" value="&lt;b&gt;cart_items&lt;/b&gt;&lt;br&gt;PK id uuid&lt;br&gt;FK user_id → users · CASCADE&lt;br&gt;FK product_id → products · RESTRICT&lt;br&gt;quantity int CHECK 1..99&lt;br&gt;UK (user_id, product_id)&lt;br&gt;created_at timestamptz&lt;br&gt;updated_at timestamptz" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#ffe6cc;strokeColor=#c98a1a;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="820" y="150" width="350" height="250" as="geometry"/>
        </mxCell>
        <mxCell id="orders" value="&lt;b&gt;orders&lt;/b&gt;&lt;br&gt;PK id uuid&lt;br&gt;FK user_id → users · RESTRICT&lt;br&gt;status PENDING|CONFIRMED|COMPLETED|CANCELLED|REJECTED&lt;br&gt;total_vnd numeric(14,0)&lt;br&gt;payment_method COD&lt;br&gt;recipient_name / phone / address_snapshot&lt;br&gt;customer_note? / rejection_reason?&lt;br&gt;idempotency_key uuid&lt;br&gt;request_hash char(64)&lt;br&gt;completed_at? / created_at / updated_at&lt;br&gt;UK (user_id, idempotency_key)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#ffe6cc;strokeColor=#c98a1a;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="820" y="430" width="350" height="360" as="geometry"/>
        </mxCell>
        <mxCell id="order_items" value="&lt;b&gt;order_items&lt;/b&gt;&lt;br&gt;PK id uuid&lt;br&gt;FK order_id → orders · RESTRICT&lt;br&gt;FK product_id → products · RESTRICT&lt;br&gt;product_name_snapshot varchar(200)&lt;br&gt;sku_snapshot varchar(64)&lt;br&gt;unit_price_vnd numeric(14,0)&lt;br&gt;quantity int 1..99&lt;br&gt;line_total_vnd numeric(14,0)&lt;br&gt;UK (order_id, product_id)&lt;br&gt;created_at timestamptz" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#ffe6cc;strokeColor=#c98a1a;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="820" y="820" width="350" height="330" as="geometry"/>
        </mxCell>

        <!-- Lane 4: Audit / Feedback / Notify -->
        <mxCell id="order_status_history" value="&lt;b&gt;order_status_history&lt;/b&gt;&lt;br&gt;PK id uuid&lt;br&gt;FK order_id → orders · RESTRICT&lt;br&gt;FK actor_user_id? → users · RESTRICT&lt;br&gt;from_status? varchar(16)&lt;br&gt;to_status varchar(16)&lt;br&gt;reason? text&lt;br&gt;created_at timestamptz&lt;br&gt;Append-only — không sửa/xóa" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#fff2cc;strokeColor=#b89b3a;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1210" y="150" width="350" height="280" as="geometry"/>
        </mxCell>
        <mxCell id="reviews" value="&lt;b&gt;reviews&lt;/b&gt;&lt;br&gt;PK id uuid&lt;br&gt;FK user_id → users · RESTRICT&lt;br&gt;FK product_id → products · RESTRICT&lt;br&gt;rating smallint CHECK 1..5&lt;br&gt;comment varchar(2000)&lt;br&gt;UK (user_id, product_id)&lt;br&gt;created_at / updated_at" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#fff2cc;strokeColor=#b89b3a;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1210" y="460" width="350" height="250" as="geometry"/>
        </mxCell>
        <mxCell id="email_notifications" value="&lt;b&gt;email_notifications&lt;/b&gt;&lt;br&gt;PK id uuid&lt;br&gt;FK order_id? → orders · RESTRICT&lt;br&gt;FK,UK auth_token_id? → auth_tokens · RESTRICT&lt;br&gt;report_period? date&lt;br&gt;event_type ∈ {EMAIL_VERIFICATION,&lt;br&gt;&amp;nbsp;&amp;nbsp;PASSWORD_RESET, ORDER_PLACED,&lt;br&gt;&amp;nbsp;&amp;nbsp;ORDER_CONFIRMED, ORDER_REJECTED,&lt;br&gt;&amp;nbsp;&amp;nbsp;MONTHLY_REVENUE}&lt;br&gt;UK order/auth/report contexts (partial)&lt;br&gt;recipient_email varchar(254)&lt;br&gt;locale en|vi · payload jsonb&lt;br&gt;secret_ciphertext? bytea&lt;br&gt;status PENDING|SENT|FAILED&lt;br&gt;attempts int 0..3&lt;br&gt;sent_at? / last_error?&lt;br&gt;created_at / updated_at" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#fff2cc;strokeColor=#b89b3a;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1210" y="740" width="350" height="490" as="geometry"/>
        </mxCell>

        <!-- Advance scope divider -->
        <mxCell id="advance_banner" value="ADVANCE SCOPE — triển khai sau khi toàn bộ Basic hoàn tất (User Advance · Admin Advance)" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#ffffff;fillColor=#9673a6;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="1270" width="1520" height="44" as="geometry"/>
        </mxCell>

        <mxCell id="chat_conversations" value="&lt;b&gt;chat_conversations&lt;/b&gt;&lt;br&gt;PK id uuid&lt;br&gt;FK customer_id → users · RESTRICT&lt;br&gt;FK assigned_admin_id? → users · RESTRICT&lt;br&gt;status OPEN|CLOSED&lt;br&gt;last_message_at? timestamptz&lt;br&gt;created_at / updated_at&lt;br&gt;UK customer_id WHERE status='OPEN'" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="1330" width="350" height="260" as="geometry"/>
        </mxCell>
        <mxCell id="chat_messages" value="&lt;b&gt;chat_messages&lt;/b&gt;&lt;br&gt;PK id uuid&lt;br&gt;FK conversation_id → chat_conversations · RESTRICT&lt;br&gt;FK sender_id → users · RESTRICT&lt;br&gt;idempotency_key uuid&lt;br&gt;request_hash char(64)&lt;br&gt;body varchar(2000)&lt;br&gt;read_at? timestamptz&lt;br&gt;created_at timestamptz&lt;br&gt;UK (sender_id, idempotency_key)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="430" y="1330" width="350" height="310" as="geometry"/>
        </mxCell>
        <mxCell id="product_suggestions" value="&lt;b&gt;product_suggestions&lt;/b&gt;&lt;br&gt;PK id uuid&lt;br&gt;FK customer_id → users · RESTRICT&lt;br&gt;FK reviewed_by? → users · RESTRICT&lt;br&gt;name varchar(200)&lt;br&gt;description? text&lt;br&gt;category_name? varchar(100)&lt;br&gt;status PENDING|APPROVED|REJECTED&lt;br&gt;review_reason? text&lt;br&gt;reviewed_at? timestamptz&lt;br&gt;created_at / updated_at" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="820" y="1330" width="370" height="340" as="geometry"/>
        </mxCell>

        <mxCell id="legend" value="&lt;b&gt;Delete policy&lt;/b&gt;&lt;br&gt;users → cart_items: CASCADE&lt;br&gt;attachments → products: SET NULL&lt;br&gt;Mọi FK lịch sử/order/product/chat/suggestion: RESTRICT&lt;br&gt;&lt;br&gt;&lt;b&gt;Cross-row rules (service + transaction)&lt;/b&gt;&lt;br&gt;• Giỏ tối đa 20 dòng&lt;br&gt;• Tổng đơn = tổng dòng hàng&lt;br&gt;• Trạng thái đơn theo state machine&lt;br&gt;• Hoàn tồn kho đúng một lần&lt;br&gt;• Email notification bền (outbox pattern)&lt;br&gt;• Mỗi customer tối đa 1 chat OPEN&lt;br&gt;• Publish WebSocket sau khi commit DB" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#f5f5f5;strokeColor=#888888;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1210" y="1330" width="350" height="420" as="geometry"/>
        </mxCell>
        <mxCell id="computed_features" value="&lt;b&gt;Không cần bảng riêng&lt;/b&gt;&lt;br&gt;Social share: URL tính từ product + PUBLIC_WEB_URL&lt;br&gt;&lt;br&gt;Best-selling / revenue: aggregate orders + order_items, chỉ COMPLETED&lt;br&gt;&lt;br&gt;Monthly report: cron tạo email_notifications theo report_period" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#f5f5f5;strokeColor=#888888;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1210" y="1770" width="350" height="240" as="geometry"/>
        </mxCell>

        <!-- Relations: FK column + multiplicity + delete policy on every edge -->
        <mxCell id="e_users_cart" value="user_id&lt;br&gt;1 : 0..N · CASCADE" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=ERmany;startArrow=ERone;startFill=0;endFill=0;fontSize=10;" edge="1" parent="1" source="users" target="cart_items"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_users_orders" value="user_id&lt;br&gt;1 : 0..N · RESTRICT" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=ERmany;startArrow=ERone;startFill=0;endFill=0;fontSize=10;" edge="1" parent="1" source="users" target="orders"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_users_history" value="actor_user_id?&lt;br&gt;0..1 : 0..N · RESTRICT" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;endArrow=ERmany;startArrow=ERone;startFill=0;endFill=0;fontSize=10;" edge="1" parent="1" source="users" target="order_status_history"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_categories_products" value="category_id&lt;br&gt;1 : 0..N · RESTRICT" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=ERmany;startArrow=ERone;startFill=0;endFill=0;fontSize=10;" edge="1" parent="1" source="categories" target="products"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_attachments_products" value="image_id?&lt;br&gt;0..1 : 0..1 · SET NULL" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;endArrow=ERone;startArrow=ERone;startFill=0;endFill=0;fontSize=10;" edge="1" parent="1" source="attachments" target="products"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_products_cart" value="product_id&lt;br&gt;1 : 0..N · RESTRICT" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=ERmany;startArrow=ERone;startFill=0;endFill=0;fontSize=10;" edge="1" parent="1" source="products" target="cart_items"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_products_items" value="product_id&lt;br&gt;1 : 0..N · RESTRICT" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=ERmany;startArrow=ERone;startFill=0;endFill=0;fontSize=10;" edge="1" parent="1" source="products" target="order_items"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_orders_items" value="order_id&lt;br&gt;1 : 1..N · RESTRICT" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=ERmany;startArrow=ERone;startFill=0;endFill=0;fontSize=10;" edge="1" parent="1" source="orders" target="order_items"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_orders_history" value="order_id&lt;br&gt;1 : 1..N · RESTRICT" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=ERmany;startArrow=ERone;startFill=0;endFill=0;fontSize=10;" edge="1" parent="1" source="orders" target="order_status_history"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_orders_notifications" value="order_id?&lt;br&gt;0..1 : 0..N · RESTRICT" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;endArrow=ERmany;startArrow=ERone;startFill=0;endFill=0;fontSize=10;" edge="1" parent="1" source="orders" target="email_notifications"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_users_tokens" value="user_id&lt;br&gt;1 : 0..N · RESTRICT" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=ERmany;startArrow=ERone;startFill=0;endFill=0;fontSize=10;" edge="1" parent="1" source="users" target="auth_tokens"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_tokens_notifications" value="auth_token_id?&lt;br&gt;0..1 : 0..1 · RESTRICT" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;endArrow=ERone;startArrow=ERone;startFill=0;endFill=0;fontSize=10;" edge="1" parent="1" source="auth_tokens" target="email_notifications"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_users_reviews" value="user_id&lt;br&gt;1 : 0..N · RESTRICT" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=ERmany;startArrow=ERone;startFill=0;endFill=0;fontSize=10;" edge="1" parent="1" source="users" target="reviews"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_products_reviews" value="product_id&lt;br&gt;1 : 0..N · RESTRICT" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=ERmany;startArrow=ERone;startFill=0;endFill=0;fontSize=10;" edge="1" parent="1" source="products" target="reviews"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_users_chat_customer" value="customer_id&lt;br&gt;1 : 0..N · RESTRICT" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=ERmany;startArrow=ERone;startFill=0;endFill=0;fontSize=10;" edge="1" parent="1" source="users" target="chat_conversations"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_users_chat_admin" value="assigned_admin_id?&lt;br&gt;0..1 : 0..N · RESTRICT" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;endArrow=ERmany;startArrow=ERone;startFill=0;endFill=0;fontSize=10;" edge="1" parent="1" source="users" target="chat_conversations"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_conversation_messages" value="conversation_id&lt;br&gt;1 : 0..N · RESTRICT" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=ERmany;startArrow=ERone;startFill=0;endFill=0;fontSize=10;" edge="1" parent="1" source="chat_conversations" target="chat_messages"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_users_messages" value="sender_id&lt;br&gt;1 : 0..N · RESTRICT" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=ERmany;startArrow=ERone;startFill=0;endFill=0;fontSize=10;" edge="1" parent="1" source="users" target="chat_messages"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_users_suggestions_customer" value="customer_id&lt;br&gt;1 : 0..N · RESTRICT" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=ERmany;startArrow=ERone;startFill=0;endFill=0;fontSize=10;" edge="1" parent="1" source="users" target="product_suggestions"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_users_suggestions_reviewer" value="reviewed_by?&lt;br&gt;0..1 : 0..N · RESTRICT" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;endArrow=ERmany;startArrow=ERone;startFill=0;endFill=0;fontSize=10;" edge="1" parent="1" source="users" target="product_suggestions"><mxGeometry relative="1" as="geometry"/></mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
